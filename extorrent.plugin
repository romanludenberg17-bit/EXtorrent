from __future__ import annotations

from typing import Any, Dict, List
from urllib.parse import urlparse

from android.widget import EditText
from base_plugin import BasePlugin, MenuItemData, MenuItemType
from client_utils import get_last_fragment
from ui.alert import AlertDialogBuilder
from ui.settings import Divider, Header, Text, Switch

__id__ = "extorrent"
__name__ = "ExTorrent"
__description__ = "Торрент-панель exteraGram: прототип очереди magnet-ссылок и интерфейса загрузок."
__author__ = "@romanludenberg17-bit"
__version__ = "0.1.1"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.10.6"
__sdk_version__ = ">=1.4.5.0"


class ExTorrentPlugin(BasePlugin):
    """UI prototype; this version deliberately does not pretend to download torrents."""

    def __init__(self):
        super().__init__()
        self._menu_item_id = None
        self._queue: List[Dict[str, Any]] = []

    def create_settings(self):
        return [
            Header(text="ExTorrent"),
            Text(
                text="Открыть панель загрузок",
                subtext="Очередь magnet-ссылок и файлов .torrent",
                icon="msg_download",
                on_click=lambda _v: self._show_panel(),
            ),
            Divider(text="Интерфейс"),
            Switch(
                key="show_menu_entry",
                text="Показывать ExTorrent в главном меню",
                subtext="Временная точка входа до проверки кнопки рядом с поиском",
                default=True,
                on_change=self._refresh_menu,
            ),
            Text(
                text="Состояние",
                subtext="UI-прототип. Настоящий BitTorrent-движок ещё не подключён, загрузки пока не выполняются.",
                icon="msg_info",
            ),
            Text(
                text="План интеграции",
                subtext="Проверить ActionBar/search на целевой версии, затем добавить движок и фоновые загрузки.",
                icon="msg_help",
            ),
        ]

    def on_plugin_load(self):
        self._refresh_menu(bool(self.get_setting("show_menu_entry", True)))

    def on_plugin_unload(self):
        item_id = self._menu_item_id
        self._menu_item_id = None
        if item_id:
            try:
                self.remove_menu_item(item_id)
            except Exception:
                pass

    def _activity(self):
        try:
            fragment = get_last_fragment()
            return fragment.getParentActivity() if fragment else None
        except Exception:
            return None

    def _refresh_menu(self, enabled=True):
        old = self._menu_item_id
        self._menu_item_id = None
        if old:
            try:
                self.remove_menu_item(old)
            except Exception:
                pass
        if not enabled:
            return
        try:
            self._menu_item_id = self.add_menu_item(
                MenuItemData(
                    menu_type=MenuItemType.MAIN_MENU,
                    text="ExTorrent",
                    subtext="Торрент-загрузки",
                    icon="msg_download",
                    on_click=lambda _context: self._show_panel(),
                    priority=30,
                )
            )
        except Exception as exc:
            self.logger.error("ExTorrent: не удалось добавить пункт меню: %s" % exc)

    def _show_panel(self):
        rows = ["Очередь пока пуста."] if not self._queue else [
            "%d. %s\n   %s" % (index, item["name"], item["status"])
            for index, item in enumerate(self._queue, 1)
        ]
        rows.extend([
            "",
            "Прототип интерфейса: добавленные ссылки пока не скачиваются.",
        ])
        activity = self._activity()
        if activity is None:
            self.logger.warning("ExTorrent: нет активного окна для показа панели")
            return
        try:
            builder = AlertDialogBuilder(activity)
            builder.set_title("ExTorrent")
            builder.set_message("\n".join(rows))
            builder.set_positive_button("Добавить ссылку", lambda _b, _w: self._prompt_link())
            builder.set_negative_button("Закрыть", lambda b, _w: b.dismiss())
            builder.show()
        except Exception as exc:
            self.logger.error("ExTorrent panel error: %s" % exc)

    def _prompt_link(self):
        activity = self._activity()
        if activity is None:
            return
        try:
            field = EditText(activity)
            field.setSingleLine(True)
            field.setHint("magnet:?xt=... или https://…/file.torrent")
            builder = AlertDialogBuilder(activity)
            builder.set_title("Добавить торрент")
            builder.set_message("Вставь magnet-ссылку или прямую ссылку на .torrent-файл.")
            builder.set_view(field)
            builder.set_positive_button(
                "Добавить",
                lambda b, _w: self._add_link(str(field.getText().toString()).strip(), b),
            )
            builder.set_negative_button("Отмена", lambda b, _w: b.dismiss())
            builder.show()
        except Exception as exc:
            self.logger.error("ExTorrent add dialog error: %s" % exc)
            self._show_info("Не удалось открыть окно добавления.")

    def _add_link(self, value: str, builder):
        if builder:
            try:
                builder.dismiss()
            except Exception:
                pass
        if not value:
            self._show_info("Ссылка пустая. Вставь magnet-ссылку или URL файла .torrent.")
            return
        if not self._valid_torrent_uri(value):
            self._show_info("Ссылка не распознана. Нужен magnet:?xt=... или HTTP(S)-ссылка, заканчивающаяся на .torrent.")
            return
        self._queue.append({
            "name": self._display_name(value),
            "uri": value,
            "status": "Ожидает подключения движка",
        })
        self._show_info("Ссылка добавлена в очередь прототипа. Реальная загрузка пока не запускается.")

    @staticmethod
    def _valid_torrent_uri(value: str) -> bool:
        low = value.lower()
        if low.startswith("magnet:?") and "xt=" in low:
            return True
        try:
            parsed = urlparse(value)
            return parsed.scheme in ("http", "https") and parsed.path.lower().endswith(".torrent")
        except Exception:
            return False

    @staticmethod
    def _display_name(value: str) -> str:
        if value.lower().startswith("magnet:"):
            for part in value.split("&"):
                if part.lower().startswith("dn="):
                    return part[3:].replace("+", " ")[:80]
            return "Magnet-загрузка"
        try:
            return urlparse(value).path.rsplit("/", 1)[-1] or "Torrent-файл"
        except Exception:
            return "Torrent-файл"

    def _show_info(self, message: str):
        activity = self._activity()
        if activity is None:
            return
        try:
            builder = AlertDialogBuilder(activity)
            builder.set_title("ExTorrent")
            builder.set_message(message)
            builder.set_positive_button("ОК", lambda b, _w: b.dismiss())
            builder.show()
        except Exception as exc:
            self.logger.error("ExTorrent dialog error: %s" % exc)
